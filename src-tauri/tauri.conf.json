{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dicho",
  "version": "0.13.0",
  "identifier": "dev.mike.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dicho — dictado por voz",
        "width": 960,
        "height": 660,
        "minWidth": 760,
        "minHeight": 540,
        "center": true
      },
      {
        "label": "hud",
        "title": "Dicho HUD",
        "width": 360,
        "height": 96,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      },
      {
        "label": "revision",
        "title": "Revisar la corrección",
        "width": 560,
        "height": 460,
        "minWidth": 420,
        "minHeight": 320,
        "resizable": true,
        "decorations": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNDNTc1RUI4MDI5NDEzMkUKUldRdUU1UUN1RjVYUEhpVEZRbFQ5SVlxbjhEMDNMZlFSM2NPRkZFRjdKUFVwYTNJK1cyRVdaOHcK",
      "endpoints": [
        "https://github.com/luisgs096/dicho/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
